# Backend config for the `prod` environment.
# Usage: terraform init -backend-config=backend/prod.tfbackend
#
# CHANGE_ME: replace with your real state bucket / lock table before first run.
bucket         = "CHANGE_ME-tfstate"
key            = "aws-rust-serverless-oltp/prod/terraform.tfstate"
region         = "eu-west-1"
dynamodb_table = "CHANGE_ME-terraform-locks"
encrypt        = true
